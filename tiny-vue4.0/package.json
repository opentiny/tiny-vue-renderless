{
  "name": "opentiny-vue",
  "version": "4.0.0",
  "description": "",
  "packageManager": "pnpm@9.14.2",
  "author": "OpenTiny Team",
  "type": "module",
  "scripts": {
    "// ---------- 创建组件 ----------": "",
    "create-cmp":"pnpm run -F @opentiny/scripts create-cmp",
    "// ---------- 开发 ----------": "",
    "dev": "pnpm run -F @opentiny/vue-docs dev",
    "dev:pc": "pnpm run -F @opentiny/vue-docs dev",
    "dev:theme": "pnpm run -F @opentiny/scene-theme dev",
    "dev:sb": "pnpm run -F @opentiny/storybook-docs storybook",
    "// ---------- 构建 ----------": "",
    "build:pc": "pnpm run -F @opentiny/vue-pc build",
    "build:theme": "pnpm run -F @opentiny/scene-theme build",
    "// ---------- 体积分析 pnpm build:all && ----------": "",
    "build:all": "pnpm build:pc",
    "usage-size": "pnpm run -F @opentiny/scripts usage-size",
    "anal:pc": "pnpm run -F @opentiny/vue-pc analyzer",
    "// ---------- 测试 ----------": "",
    "init-e2e": "playwright install",
    "test": "vitest",
    "test:e2e": "playwright test",
    "// ---------- 代码格式化 ----------": "",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "// ---------- 其它 ----------": "",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://szv-open.codehub.huawei.com/innersource/TinyStage/opentiny/ui-vue/tiny-vue-renderless.git"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,}": "pnpm lint"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "@types/node": "catalog:",
    "@tsconfig/node20": "catalog:",
    "@playwright/test": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "commitlint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "npm-run-all2": "catalog:",
    "oxlint": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "unocss": "catalog:",
    "@unocss/preset-icons": "catalog:",
    "typescript": "catalog:",
    "@opentiny/icons": "catalog:",
    "node-modules-inspector": "catalog:"
  },
  "keywords": [],
  "license": "ISC"
}
