{
  "name": "lowcode-portal",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "npm run obtainDocTime && cross-env API_MOCK=mock vite",
    "serve": "vite",
    "build:alpha": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode alpha",
    "build:alpha-open": "cross-env API_MOCK=mock NODE_OPTIONS=--max-old-space-size=8192 vite build --mode alpha-open",
    "build:open": "cross-env API_MOCK=mock NODE_OPTIONS=--max-old-space-size=8192 vite build --mode open",
    "build:prod": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode prod",
    "build:dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build --mode development",
    "build:card": "vite build --config card.config.js",
    "preview": "vite preview --mode development",
    "prepare": "husky install",
    "lint": "eslint . --ext .js,.vue,.jsx",
    "obtainDocTime": "node ./scripts/getDocsMdTime.js"
  },
  "dependencies": {
    "@huawei/tinybuilder-common": "^1.0.1",
    "@opentiny/tiny-engine-setting-design": "^1.0.1",
    "@opentiny/vue": "~3.14.0",
    "@opentiny/vue-design-smb": "~3.14.0",
    "@opentiny/vue-icon": "~3.14.0",
    "@opentiny/vue-locale": "~3.14.0",
    "@opentiny/vue-renderless": "~3.14.0",
    "@opentiny/vue-theme": "~3.14.0",
    "@vueuse/core": "^9.6.0",
    "marked": "^4.0.17",
    "monaco-editor": "0.33.0",
    "qs": "^6.11.0",
    "vue": "3.4.21",
    "vue-clipboard3": "^2.0.0",
    "vue-draggable-next": "2.1.0",
    "vue-i18n": "^9.2.0-beta.3",
    "vue-router": "4"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.22.15",
    "@cloud/eslint-config-cbc": "^1.7.3",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-standard": "^8.0.1",
    "buffer": "^6.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.48.0",
    "eslint-plugin-vue": "^9.17.0",
    "fast-glob": "^3.3.3",
    "github-markdown-css": "^5.1.0",
    "husky": "^8.0.0",
    "less": "^4.1.2",
    "less-loader": "^7.3.0",
    "lint-staged": "^14.0.1",
    "path": "^0.12.7",
    "prettier": "^2.6.0",
    "rollup-plugin-polyfill-node": "^0.10.1",
    "svg-sprite-loader": "^6.0.11",
    "vite": "^4.5.1",
    "vite-plugin-css-injected-by-js": "^3.3.0",
    "vite-plugin-markdown": "^2.2.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
