        "state": {
          "target": null,
          "moduleDetail": null,
          "pageName": null
        },
        "methods": {
          "loadRemoteModule": {
            "type": "JSFunction",
            "value": "function loadRemoteModule() {\n  const localComponent = props.moduleDetail.localComponent ? this.bridge[props.moduleDetail.localComponent] : null;\n  const localModule = props.moduleDetail.localModule ? this.bridge[props.moduleDetail.localModule] : null;\n  this.state.target = this.$('remoteTarget');\n  this.state.moduleDetail = props.moduleDetail;\n  this.state.pageName = props.moduleDetail.pageName;\n  this.bridge.services[this.state.pageName]?.load(this.state.target, { ...props.moduleDetail,\n    localComponent,\n    localModule\n  });\n}"
          },
          "unloadRemoteModule": {
            "type": "JSFunction",
            "value": "function unloadRemoteModule() {\n  this.bridge.services[this.state.pageName]?.unload(this.state.moduleDetail);\n}"
          },
          "initListener": {
            "type": "JSFunction",
            "value": "function initListener() {\n  this.bridge.addEventListener('ngViewInit', loadRemoteModule);\n}"
          },
          "removeListener": {
            "type": "JSFunction",
            "value": "function removeListener() {\n  this.bridge.removeEventListener('ngViewInit', loadRemoteModule);\n}"
          }
        },
        "dataSource": {},
        "i18n": {},
        "lifeCycles": {
          "setup": {
            "type": "JSFunction",
            "value": "function setup ({ props, state, watch, onMounted }) {\r\n  watch(\r\n    () => props.moduleDetail,\r\n    () => {\r\n      if (!props.moduleDetail) return;\r\n      loadRemoteModule();\r\n    }\r\n  );\r\n} "
          },
          "onUnmounted": {
            "type": "JSFunction",
            "value": "function onUnmounted () {\r\n  unloadRemoteModule();\r\n  removeListener();\r\n} "
          },
          "onMounted": {
            "type": "JSFunction",
            "value": "function onMounted () {\r\n  loadRemoteModule();\r\n  initListener();\r\n} "
          }
        }
      },
